# Copy to `.env` in repo root before `docker compose up`, or export in shell.
# Staging and production share this layout. Production omits Razorpay keys.

# --- Environment / Secrets Manager ---
# development | staging | production
# Staging Docker still sets NODE_ENV=production; TUTORIX_ENV selects Razorpay test vs live.
TUTORIX_ENV=staging
AWS_SECRET_NAME=tutorix/app
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- Public URLs / CORS / Compose ports ---
FRONTEND_URL=https://dev.tutorix.tech
CORS_ORIGINS=https://dev-admin.tutorix.tech
# VITE_FRONTEND_URL=https://dev.tutorix.tech
GATEWAY_HTTP_PORT=8080
ADMIN_HTTP_PORT=81
VITE_GRAPHQL_ENDPOINT=/api/graphql

# --- Database (host/port/name only; user/password from Secrets Manager) ---
# DB_HOST=postgres
DOCKER_DB_HOST=172.17.0.1
DB_PORT=5432
DB_NAME=tutorix
DB_SYNCHRONIZE=true
AUTO_RUN_MIGRATIONS=false

# --- Maps ---
# GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GEOAPIFY_API_KEY=

# --- Payments ---
PAYMENT_GATEWAY=razorpay
# Staging only: test Razorpay keys (production omits these; live keys come from SM)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# Per-env secret from Razorpay Dashboard → Webhooks (test on staging, live on production)
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_CHECKOUT_THEME_COLOR=#5fa8ff
# PAYMENT_SETTLEMENT_BATCH_ENABLED=true
# PAYMENT_SETTLEMENT_BATCH_CRON=0 * * * *
# PAYMENT_SETTLEMENT_BATCH_LIMIT=50

# --- Document screening batch (ANTHROPIC_API_KEY from Secrets Manager) ---
# ANTHROPIC_DOCUMENT_SCREENING_MODEL=claude-sonnet-4-6
# DOCUMENT_SCREENING_BATCH_ENABLED=true
# DOCUMENT_SCREENING_BATCH_CRON=*/5 * * * *
# DOCUMENT_SCREENING_BATCH_LIMIT=20
# DOCUMENT_SCREENING_CONFIDENCE_THRESHOLD=0.85

# --- Tutor onboarding approval batch ---
# TUTOR_APPROVAL_BATCH_ENABLED=true
# TUTOR_APPROVAL_BATCH_CRON=*/5 * * * *
# TUTOR_APPROVAL_BATCH_LIMIT=20

# --- S3 documents ---
# AWS_REGION: EC2 / Secrets Manager / SES (instances are in us-east-1)
# S3_DOCUMENTS_BUCKET_REGION must match the bucket region
# S3_DOCUMENTS_BUCKET=tutorix-documents-dev
# S3_DOCUMENTS_BUCKET_REGION=us-east-2
# Prefer EC2 IAM instance profile; omit ACCESS_KEY_* on instance
# DOCUMENT_PUBLIC_BASE_URL=

# --- Email (AWS SES) ---
# EMAIL_PROVIDER=ses
# SES_FROM_EMAIL=info@tutorix.tech
# SES_FROM_NAME=Tutorix
# SES_REGION=us-east-1

# --- Firebase (Admin JSON from Secrets Manager) ---
# FIREBASE_PROJECT_ID=tutorix-b7882
