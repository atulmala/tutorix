# Copy to `.env` in the repo root for local Nx development (not committed).
# For Docker Compose on a server, see `.env.docker.example`.
#
# Secrets Manager `tutorix/app` supplies: JWT_SECRET, DB_USERNAME, DB_PASSWORD,
# ANTHROPIC_API_KEY, FIREBASE_SERVICE_ACCOUNT_JSON.
# Production also loads live RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET from that secret.

# --- Environment / Secrets Manager ---
# development | staging | production — Razorpay live keys apply only when production
TUTORIX_ENV=development
AWS_SECRET_NAME=tutorix/app
AWS_REGION=us-east-1

# --- Process ---
# PORT=3000
# NODE_ENV=development

# --- Public URLs / CORS ---
FRONTEND_URL=http://localhost:4200
# CORS_ORIGINS=http://localhost:4201
# VITE_GRAPHQL_ENDPOINT=http://localhost:3000/api/graphql
# Optional pin; otherwise Metro/Babel detect this machine's LAN IPv4 at load.
# DEV_LAN_HOST=192.168.1.50

# --- Database (host/port/name only; user/password from Secrets Manager) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tutorix
# DB_SYNCHRONIZE=false
# AUTO_RUN_MIGRATIONS=false

# --- Maps ---
# GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GEOAPIFY_API_KEY=

# --- Payments ---
# PAYMENT_GATEWAY=razorpay
# Test keys for local/staging. Production omits these; live keys come from SM.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# Per-env secret from Razorpay Dashboard → Webhooks (test locally/staging, live in production)
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_CHECKOUT_THEME_COLOR=#5fa8ff
# PAYMENT_SETTLEMENT_BATCH_ENABLED=true
# PAYMENT_SETTLEMENT_BATCH_CRON=0 * * * *
# PAYMENT_SETTLEMENT_BATCH_LIMIT=50

# --- Document screening batch (ANTHROPIC_API_KEY from Secrets Manager) ---
# ANTHROPIC_DOCUMENT_SCREENING_MODEL=claude-sonnet-4-6
# DOCUMENT_SCREENING_BATCH_ENABLED=true
# DOCUMENT_SCREENING_BATCH_CRON=*/5 * * * *
# DOCUMENT_SCREENING_BATCH_LIMIT=20
# DOCUMENT_SCREENING_CONFIDENCE_THRESHOLD=0.85

# --- Tutor onboarding approval batch ---
# TUTOR_APPROVAL_BATCH_ENABLED=true
# TUTOR_APPROVAL_BATCH_CRON=*/5 * * * *
# TUTOR_APPROVAL_BATCH_LIMIT=20

# --- S3 documents ---
# S3_DOCUMENTS_BUCKET=tutorix-documents-dev
# S3_DOCUMENTS_BUCKET_REGION=us-east-2
# Local only: long-lived IAM keys. EC2 uses instance role TutorixEC2Role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Email (AWS SES) ---
# EMAIL_PROVIDER=console
# EMAIL_PROVIDER=ses
# SES_FROM_EMAIL=info@tutorix.tech
# SES_FROM_NAME=Tutorix
# SES_REGION=us-east-1

# --- Firebase (Admin JSON from Secrets Manager) ---
# FIREBASE_PROJECT_ID=tutorix-b7882
